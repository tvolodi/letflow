# Untracked local config -- copy this file to `.env` and fill in real values.
# `.env` itself is gitignored; this file documents what belongs there.

# REQ-190 / docs/migration/decisions/0016-secrets-storage-backend.md §B.
# The envelope-encryption master key for Letflow.Secrets. Required in every
# environment Letflow boots in (dev, test, prod) -- config/runtime.exs fails
# startup loudly if it is absent, malformed, or a trivially-guessable value
# (all-zeros / all-0xFF). Never commit a real value here.
#
# generate with: openssl rand -hex 32
LETFLOW_SECRETS_MASTER_KEY=

# Per-workspace PostgreSQL host port override -- see README.md and
# config/db_port.exs. Leave unset to use the 5462 default.
# LETFLOW_DB_PORT=

# Per-workspace Keycloak host port override -- see config/keycloak_port.exs.
# LETFLOW_KEYCLOAK_PORT=
