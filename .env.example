# Untracked local config -- copy this file to `.env` and fill in real values.
# `.env` itself is gitignored; this file documents what belongs there.

# REQ-190 / docs/migration/decisions/0016-secrets-storage-backend.md §B.
# The envelope-encryption master key for Letflow.Secrets. Required in every
# environment Letflow boots in (dev, test, prod) -- config/runtime.exs fails
# startup loudly if it is absent, malformed, or a trivially-guessable value
# (all-zeros / all-0xFF). Never commit a real value here.
#
# generate with: openssl rand -hex 32
LETFLOW_SECRETS_MASTER_KEY=

# Per-workspace PostgreSQL host port override -- see README.md and
# config/db_port.exs. Leave unset to use the 5462 default.
# LETFLOW_DB_PORT=

# Per-workspace Keycloak host port override -- see config/keycloak_port.exs.
# LETFLOW_KEYCLOAK_PORT=

# REQ-435 / 0043 D-C: keyed-HMAC pepper(s) for the platform tenant-login directory
# (email-first login). PEPPER and PEPPER_ID are required in every environment
# Letflow boots in -- config/runtime.exs fails startup if either is absent,
# malformed, or (pepper) trivially guessable / equal to LETFLOW_SECRETS_MASTER_KEY.
# PEPPER: 64 lowercase hex chars. PEPPER_ID: 1..32 chars of [a-z0-9_-], never reused.
# PEPPER_PREVIOUS and PEPPER_PREVIOUS_ID are set ONLY during a planned rotation and
# must be set BOTH or NEITHER (and differ from the current pair). Never commit a real value.
#
# generate with: openssl rand -hex 32
LETFLOW_LOGIN_DIRECTORY_PEPPER=
LETFLOW_LOGIN_DIRECTORY_PEPPER_ID=
LETFLOW_LOGIN_DIRECTORY_PEPPER_PREVIOUS=
LETFLOW_LOGIN_DIRECTORY_PEPPER_PREVIOUS_ID=

# Optional (REQ-444) -- legal-confirmation marker for the email-first login directory. Leave
# BLANK until a named person has confirmed the lawful basis/controller (decision 0042 OQ-3).
# The value is that person's reference and a date, at least 8 characters; never logged. It is
# ADVISORY (it cannot prove a confirmation happened). Required, together with a delivering mail
# adapter (LETFLOW_MAIL_ADAPTER=smtp), to enable the feature outside dev/test: boot is refused
# otherwise. See docs/runbooks/login-directory-enablement.md.
LETFLOW_LOGIN_DIRECTORY_LEGAL_CONFIRMATION=
# Optional (REQ-441) -- notifier mail adapter. Unset/blank = no mail is sent (Noop).
# smtp = send via SMTP. Credentials are issued and owned by the platform operator and
# registered in the ai-dala-infra secrets inventory; no value belongs in this file.
LETFLOW_MAIL_ADAPTER=
# REQUIRED when LETFLOW_MAIL_ADAPTER=smtp (each stops boot when missing; values never echoed):
LETFLOW_SMTP_HOST=
LETFLOW_SMTP_PORT=
LETFLOW_SMTP_USERNAME=
LETFLOW_SMTP_PASSWORD=
LETFLOW_MAIL_FROM=
LETFLOW_PUBLIC_BASE_URL=
# Optional: starttls (default) | tls | none (none only for a loopback host and never in prod)
LETFLOW_SMTP_TLS=
# Optional: milliseconds, 2000..30000, default 15000 (hard timeout of one delivery attempt).
# Capacity note: up to max_concurrent (default 100) deliveries may hold a relay connection at
# once; set the relay's per-account connection limit >= that, or lower max_concurrent.
# The outbound rate ceiling is the global login-discovery limiter, not this setting.
LETFLOW_MAIL_TIMEOUT_MS=
