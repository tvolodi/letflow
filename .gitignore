# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
letflow-*.tar

# Temporary files, for example, from tests.
/tmp/

# Local environment / secrets — never commit
.env
.env.*
# ...except the deploy env *template* (no real secrets, tracked on purpose
# so `deploy/.env` has something to be copied from) — same convention as
# the sibling letflow-queue repo's deploy/.env.example.
!deploy/.env.example

# Scratch space for one-off scripts, debug dumps, logs — see
# docs/agents/instructions/core-directives.md's file-placement rules
/scratch/

# ── Frontend (web/) — Node / Vite / Playwright ───────────────────────────────
# web/ is Letflow's own React SPA as of the S8 re-scope (2026-08-21); see
# docs/migration/decisions/0011-frontend-ownership.md.
web/node_modules/
web/dist/
web/.vite/
web/test-results/
web/playwright-report/
web/coverage/
*.tsbuildinfo
# Test *evidence* (screenshots written by page.screenshot, a11y run reports) is
# run output, not a baseline — R-Co tracked these and they grew to 16 MB. Not
# carried over, not tracked here.
web/tests/screenshots/
web/tests/reports/
# The frontend env template is tracked on purpose (the blanket `.env.*` rule
# above would otherwise swallow it).
!web/.env.example
