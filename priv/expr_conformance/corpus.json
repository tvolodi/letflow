    "expression": "amount +",
    "variables": {},
    "outcome": {"status": "error", "error_kind": "parse_failure"}
  },
  {
    "id": "expr-036",
    "description": "Integer division by zero is an eval-time error; the expression parses successfully.",
    "grammar_constructs": ["arith:div", "lit:integer"],
    "expression": "5 / 0",
    "variables": {},
    "outcome": {"status": "error", "error_kind": "eval_failure"}
  },
  {
    "id": "expr-037",
    "description": "Referencing a variable absent from the variables map is an eval-time error.",
    "grammar_constructs": ["cmp:gt", "lit:integer", "var:simple"],
    "expression": "missing > 1",
    "variables": {},
    "outcome": {"status": "error", "error_kind": "eval_failure"}
  },
  {
    "id": "expr-038",
    "description": "An ordering comparison between a string variable and an integer literal is a type-mismatch eval error.",
    "grammar_constructs": ["cmp:gt", "lit:integer", "var:simple"],
    "expression": "name > 5",
    "variables": {"name": "bob"},
    "outcome": {"status": "error", "error_kind": "eval_failure"}
  },
  {
    "id": "expr-039",
    "description": "Adding null (via a null-valued variable) to an integer is an eval-time error; null propagates as an error in arithmetic.",
    "grammar_constructs": ["arith:add", "lit:integer", "lit:null", "var:simple"],
    "expression": "amount + 1",
    "variables": {"amount": null},
    "outcome": {"status": "error", "error_kind": "eval_failure"}
  },
  {
    "id": "expr-040",
    "description": "Null asymmetry: null (via a null-valued variable) in an ordering comparison yields null, not an error.",
    "grammar_constructs": ["cmp:lt", "lit:null", "var:simple"],
    "expression": "amount < 100",
    "variables": {"amount": null},
    "outcome": {"status": "ok", "value": null}
  }
