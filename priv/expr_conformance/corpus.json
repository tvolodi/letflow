    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-018",
    "description": "length/1 returns the byte length of a string literal.",
    "grammar_constructs": ["builtin:length", "lit:string", "lit:integer"],
    "expression": "length(\"hello\")",
    "variables": {},
    "outcome": {"status": "ok", "value": 5}
  },
  {
    "id": "expr-019",
    "description": "lower/1 converts ASCII letters to lowercase.",
    "grammar_constructs": ["builtin:lower", "lit:string"],
    "expression": "lower(\"HELLO\")",
    "variables": {},
    "outcome": {"status": "ok", "value": "hello"}
  },
  {
    "id": "expr-020",
    "description": "upper/1 converts ASCII letters to uppercase.",
    "grammar_constructs": ["builtin:upper", "lit:string"],
    "expression": "upper(\"hello\")",
    "variables": {},
    "outcome": {"status": "ok", "value": "HELLO"}
  },
  {
    "id": "expr-021",
    "description": "trim/1 strips leading and trailing ASCII whitespace (spaces only).",
    "grammar_constructs": ["builtin:trim", "lit:string"],
    "expression": "trim(\"  hello  \")",
    "variables": {},
    "outcome": {"status": "ok", "value": "hello"}
  },
  {
    "id": "expr-022",
    "description": "contains/2 returns true when the needle is a substring of the haystack.",
    "grammar_constructs": ["builtin:contains", "lit:string", "lit:boolean"],
    "expression": "contains(\"hello world\", \"wor\")",
    "variables": {},
    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-023",
    "description": "startsWith/2 returns true when the haystack starts with the given prefix.",
    "grammar_constructs": ["builtin:startsWith", "lit:string"],
    "expression": "startsWith(\"hello world\", \"hello\")",
    "variables": {},
    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-024",
    "description": "endsWith/2 returns true when the haystack ends with the given suffix.",
    "grammar_constructs": ["builtin:endsWith", "lit:string"],
    "expression": "endsWith(\"hello world\", \"world\")",
    "variables": {},
    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-025",
    "description": "coalesce/N returns the first non-null argument.",
    "grammar_constructs": ["builtin:coalesce", "lit:integer"],
    "expression": "coalesce(null, 42)",
    "variables": {},
    "outcome": {"status": "ok", "value": 42}
  },
  {
    "id": "expr-026",
    "description": "lower/1 is ASCII-only: the non-ASCII É in \"CAFÉ\" is left unchanged, yielding \"cafÉ\" not \"café\".",
    "grammar_constructs": ["builtin:lower", "lit:string"],
    "expression": "lower(\"CAFÉ\")",
    "variables": {},
    "outcome": {"status": "ok", "value": "cafÉ"}
  },
  {
    "id": "expr-027",
    "description": "upper/1 is ASCII-only: the non-ASCII é in \"café\" is left unchanged, yielding \"CAFé\" not \"CAFÉ\".",
    "grammar_constructs": ["builtin:upper", "lit:string"],
    "expression": "upper(\"café\")",
    "variables": {},
    "outcome": {"status": "ok", "value": "CAFé"}
  },
  {
    "id": "expr-028",
    "description": "trim/1 strips all four ASCII whitespace kinds (space, tab, CR, LF) from both ends.",
    "grammar_constructs": ["builtin:trim", "lit:string"],
    "expression": "trim(\" \thi there\r\n \")",
    "variables": {},
    "outcome": {"status": "ok", "value": "hi there"}
  },
  {
    "id": "expr-029",
    "description": "Positive float divided by 0.0 produces positive infinity.",
    "grammar_constructs": ["arith:div", "lit:float"],
    "expression": "1.0 / 0.0",
    "variables": {},
    "outcome": {"status": "ok", "value": {"$marker": "infinity"}}
  },
  {
    "id": "expr-030",
    "description": "Negative float divided by 0.0 produces negative infinity.",
    "grammar_constructs": ["arith:div", "arith:neg", "lit:float"],
    "expression": "- 1.0 / 0.0",
    "variables": {},
    "outcome": {"status": "ok", "value": {"$marker": "neg_infinity"}}
  },
  {
    "id": "expr-031",
    "description": "Zero float divided by 0.0 produces NaN.",
    "grammar_constructs": ["arith:div", "lit:float"],
    "expression": "0.0 / 0.0",
    "variables": {},
    "outcome": {"status": "ok", "value": {"$marker": "nan"}}
  },
  {
    "id": "expr-032",
