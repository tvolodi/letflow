    "expression": "2 + 3 * 4 == 14",
    "variables": {},
    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-033",
    "description": "Integer operand divided by a float literal promotes to float: 7 / 2.0 = 3.5, not 3.",
    "grammar_constructs": ["arith:div", "lit:integer", "lit:float"],
    "expression": "7 / 2.0",
    "variables": {},
    "outcome": {"status": "ok", "value": 3.5}
  },
