[
  {
    "id": "expr-001",
    "description": "Equality comparison of a simple variable against an integer literal.",
    "grammar_constructs": ["cmp:eq", "lit:integer", "var:simple"],
    "expression": "amount == 100",
    "variables": {"amount": 100},
    "outcome": {"status": "ok", "value": true}
  },
  {
    "id": "expr-002",
    "description": "Inequality comparison of a simple variable against a string literal.",
    "grammar_constructs": ["cmp:neq", "lit:string", "var:simple"],
    "expression": "status != \"active\"",
    "variables": {"status": "pending"},
    "outcome": {"status": "ok", "value": true}
  },
  {
