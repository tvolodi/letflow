{
  "name": "Loan Origination",
  "version": "1.10",
  "description": "Full SME loan origination flow. Three parallel assessment tracks (credit, risk, KYC/AML). Standard path uses L1+L2 sign-off; large loans go to Credit Committee (multi-voter, mapped to HUMAN_TASK). Exercises: parallel fork-join, conditional authority routing, service-task core banking. KYC/AML fails closed (v1.7): the eligibility gate lets an application on to approval only when the screening answered kyc_status 'clear' or the compliance officer's manual review recorded kyc_outcome 'cleared' (the kyc-manual-review task is completed with output variable kyc_outcome = cleared | rejected); a rejected, missing or timed-out review (kyc-timeout records kyc_outcome 'unresolved') declines the application. Committee votes are person-distinct by role (v1.8): committee-vote-cro routes to role-cro, committee-vote-director to role-credit-director and committee-vote-ceo to role-ceo, three different roles held by three different people, so one committee member cannot cast two or three of the votes. Timeouts before the eligibility gate no longer skip the value the gate reads (v1.9, ISS-1015 / Q-997): when credit-memo-review or risk-assessment times out, the flag service task now leads to a human escalation review (credit-memo-escalation-review for role-credit-director records credit_decision; risk-assessment-escalation-review for role-cro records risk_rating) before assessment-join, so a timeout means more scrutiny, not a silent decline; the eligibility-gate default to decline-application stays as the fail-closed fallback if a review is completed without the value. Every human task carries a form_schema naming the decision field(s) to record; form_schema is a UI rendering payload only, the fail-closed gateway defaults are the enforcement.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "node_type": "START"
      },
      {
        "id": "parallel-assessment-fork",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "credit-memo-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-manager",
          "form_schema": {
            "type": "object",
            "properties": {
              "credit_decision": {
                "type": "string",
                "title": "Credit decision",
                "description": "Credit memo outcome. 'pass' lets the application proceed to the eligibility gate; 'fail' declines it. eligibility-gate reads this.",
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "credit_decision"
            ]
          }
        }
      },
      {
        "id": "credit-memo-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "credit-memo-escalation-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-director",
          "form_schema": {
            "type": "object",
            "properties": {
              "credit_decision": {
                "type": "string",
                "title": "Credit decision",
                "description": "Escalation review of a credit memo that was not completed in time. Record the credit decision yourself: 'pass' proceeds to the eligibility gate, 'fail' declines. Leaving it unset declines the application (fail-closed).",
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "credit_decision"
            ]
          }
        }
      },
      {
        "id": "risk-assessment",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-risk-manager",
          "form_schema": {
            "type": "object",
            "properties": {
              "risk_rating": {
                "type": "string",
                "title": "Risk rating",
                "description": "Risk assessment outcome. 'unacceptable' declines the application; any other rating lets it proceed to the eligibility gate. eligibility-gate reads this.",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unacceptable"
                ]
              }
            },
            "required": [
              "risk_rating"
            ]
          }
        }
      },
      {
        "id": "risk-assessment-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "risk-assessment-escalation-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-cro",
          "form_schema": {
            "type": "object",
            "properties": {
              "risk_rating": {
                "type": "string",
                "title": "Risk rating",
                "description": "Escalation review of a risk assessment that was not completed in time. Record the risk rating yourself: 'unacceptable' declines, any other rating proceeds to the eligibility gate. Leaving it unset declines the application (fail-closed).",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unacceptable"
                ]
              }
            },
            "required": [
              "risk_rating"
            ]
          }
        }
      },
      {
        "id": "kyc-aml-check",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/response-headers?kyc_status=clear",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "kyc-manual-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-compliance-officer",
          "form_schema": {
            "type": "object",
            "properties": {
              "kyc_outcome": {
                "type": "string",
                "title": "KYC/AML outcome",
                "description": "Result of the manual KYC/AML review. Only 'cleared' lets the application proceed; 'rejected' (or no answer) declines it.",
                "enum": [
                  "cleared",
                  "rejected"
                ]
              }
            },
            "required": [
              "kyc_outcome"
            ]
          }
        }
      },
      {
        "id": "kyc-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/response-headers?kyc_outcome=unresolved",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "kyc-routing",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "assessment-join",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "eligibility-gate",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "authority-routing",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "l1-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-manager",
          "form_schema": {
            "type": "object",
            "properties": {
              "l1_decision": {
                "type": "string",
                "title": "L1 decision",
                "description": "Level 1 credit decision: 'approve' or 'escalate' passes to L2 approval, 'reject' declines.",
                "enum": [
                  "approve",
                  "escalate",
                  "reject"
                ]
              }
            },
            "required": [
              "l1_decision"
            ]
          }
        }
      },
      {
        "id": "l2-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-director",
          "form_schema": {
            "type": "object",
            "properties": {
              "l2_decision": {
                "type": "string",
                "title": "L2 decision",
                "description": "Level 2 credit decision: 'approve' creates the facility, 'reject' (or no answer) declines.",
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            },
            "required": [
              "l2_decision"
            ]
          }
        }
      },
      {
        "id": "committee-vote-fork",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "committee-vote-cro",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-cro",
          "form_schema": {
            "type": "object",
            "properties": {
              "committee_vote_cro": {
                "type": "string",
                "title": "CRO vote",
                "description": "The CRO's committee vote. Two matching votes of three decide; a missing vote counts for neither side.",
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            },
            "required": [
              "committee_vote_cro"
            ]
          }
        }
      },
      {
        "id": "committee-vote-director",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-director",
          "form_schema": {
            "type": "object",
            "properties": {
              "committee_vote_director": {
                "type": "string",
                "title": "Credit director vote",
                "description": "The credit director's committee vote. Two matching votes of three decide; a missing vote counts for neither side.",
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            },
            "required": [
              "committee_vote_director"
            ]
          }
        }
      },
      {
        "id": "committee-vote-ceo",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-ceo",
          "form_schema": {
            "type": "object",
            "properties": {
              "committee_vote_ceo": {
                "type": "string",
                "title": "CEO vote",
                "description": "The CEO's committee vote. Two matching votes of three decide; a missing vote counts for neither side.",
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            },
            "required": [
              "committee_vote_ceo"
            ]
          }
        }
      },
      {
        "id": "committee-vote-cro-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-director-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-ceo-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-join",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "committee-tally",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "create-facility",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/core-banking/facilities",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "disburse-loan",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-loan-ops",
          "form_schema": {
            "type": "object",
            "properties": {
              "disbursement_reference": {
                "type": "string",
                "title": "Disbursement reference",
                "description": "Core-banking reference of the disbursement that was made. Recorded for audit; no gateway reads it. Optional. No personal data beyond what the process needs.",
                "minLength": 1
              }
            }
          }
        }
      },
      {
        "id": "decline-application",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/crm/applications/{{variables.application_id}}/decline",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "end-disbursed",
        "node_type": "END"
      },
      {
        "id": "end-declined",
        "node_type": "END"
      }
    ],
    "edges": [
      { "id": "e0",                          "source": "start",                  "target": "parallel-assessment-fork" },
      { "id": "e1",                          "source": "parallel-assessment-fork", "target": "credit-memo-review" },
      { "id": "e2",                          "source": "parallel-assessment-fork", "target": "risk-assessment" },
      { "id": "e3",                          "source": "parallel-assessment-fork", "target": "kyc-aml-check" },
      { "id": "e4",                          "source": "credit-memo-review",     "target": "assessment-join" },
      { "id": "timeout-credit-memo-review",  "source": "credit-memo-review",     "target": "credit-memo-timeout" },
      { "id": "e5",                          "source": "credit-memo-timeout",    "target": "credit-memo-escalation-review" },
      { "id": "e5-escalation-reviewed",     "source": "credit-memo-escalation-review", "target": "assessment-join" },
      { "id": "e6",                          "source": "risk-assessment",        "target": "assessment-join" },
      { "id": "timeout-risk-assessment",     "source": "risk-assessment",        "target": "risk-assessment-timeout" },
      { "id": "e7",                          "source": "risk-assessment-timeout", "target": "risk-assessment-escalation-review" },
      { "id": "e7-escalation-reviewed",     "source": "risk-assessment-escalation-review", "target": "assessment-join" },
      { "id": "e8",                          "source": "kyc-aml-check",          "target": "kyc-routing" },
      { "id": "e9",                          "source": "kyc-routing",            "target": "assessment-join",      "condition": "variables.kyc_status == 'clear'" },
      { "id": "e10",                         "source": "kyc-routing",            "target": "kyc-manual-review",    "condition": "variables.kyc_status == 'hit'" },
      { "id": "e11",                         "source": "kyc-routing",            "target": "kyc-manual-review",    "condition": "variables.kyc_status == 'inconclusive'" },
      { "id": "e9-default",                  "source": "kyc-routing",            "target": "kyc-manual-review",      "is_default": true },
      { "id": "e12",                         "source": "kyc-manual-review",      "target": "assessment-join" },
      { "id": "timeout-kyc-manual-review",   "source": "kyc-manual-review",      "target": "kyc-timeout" },
      { "id": "e13",                         "source": "kyc-timeout",            "target": "assessment-join" },
      { "id": "e14",                         "source": "assessment-join",        "target": "eligibility-gate" },
      { "id": "e15",                         "source": "eligibility-gate",       "target": "authority-routing",    "condition": "variables.credit_decision == 'pass' && variables.risk_rating != null && variables.risk_rating != '' && variables.risk_rating != 'unacceptable' && variables.kyc_status == 'clear'" },
      { "id": "e15-kyc-cleared",            "source": "eligibility-gate",       "target": "authority-routing",    "condition": "variables.credit_decision == 'pass' && variables.risk_rating != null && variables.risk_rating != '' && variables.risk_rating != 'unacceptable' && variables.kyc_outcome == 'cleared'" },
      { "id": "e16",                         "source": "eligibility-gate",       "target": "decline-application",  "condition": "variables.credit_decision == 'fail' || variables.risk_rating == 'unacceptable'" },
      { "id": "eligibility-gate-default", "source": "eligibility-gate", "target": "decline-application", "is_default": true },
      { "id": "e17",                         "source": "authority-routing",      "target": "l1-approval",          "condition": "variables.requested_amount_eur <= 500000" },
      { "id": "e18",                         "source": "authority-routing",      "target": "committee-vote-fork",  "condition": "variables.requested_amount_eur > 500000" },
      { "id": "authority-routing-default", "source": "authority-routing", "target": "decline-application", "is_default": true },
      { "id": "e19",                         "source": "l1-approval",            "target": "l2-approval",          "condition": "variables.l1_decision == 'approve' || variables.l1_decision == 'escalate'" },
      { "id": "e20",                         "source": "l1-approval",            "target": "decline-application",  "condition": "variables.l1_decision == 'reject'" },
      { "id": "fallback-l1-approval",        "source": "l1-approval",            "target": "l2-approval" },
      { "id": "e21",                         "source": "l2-approval",            "target": "create-facility",      "condition": "variables.l2_decision == 'approve'" },
      { "id": "e22",                         "source": "l2-approval",            "target": "decline-application",  "condition": "variables.l2_decision == 'reject'" },
      { "id": "fallback-l2-approval",        "source": "l2-approval",            "target": "decline-application" },
      { "id": "e29",                         "source": "committee-vote-fork",    "target": "committee-vote-cro" },
      { "id": "e30",                         "source": "committee-vote-fork",    "target": "committee-vote-director" },
      { "id": "e31",                         "source": "committee-vote-fork",    "target": "committee-vote-ceo" },
      { "id": "e32",                         "source": "committee-vote-cro",     "target": "committee-vote-join" },
      { "id": "e33",                         "source": "committee-vote-director", "target": "committee-vote-join" },
      { "id": "e34",                         "source": "committee-vote-ceo",     "target": "committee-vote-join" },
      { "id": "timeout-committee-vote-cro",      "source": "committee-vote-cro",      "target": "committee-vote-cro-timeout" },
      { "id": "timeout-committee-vote-director", "source": "committee-vote-director", "target": "committee-vote-director-timeout" },
      { "id": "timeout-committee-vote-ceo",      "source": "committee-vote-ceo",      "target": "committee-vote-ceo-timeout" },
      { "id": "e35",                         "source": "committee-vote-cro-timeout",      "target": "committee-vote-join" },
      { "id": "e36",                         "source": "committee-vote-director-timeout", "target": "committee-vote-join" },
      { "id": "e37",                         "source": "committee-vote-ceo-timeout",      "target": "committee-vote-join" },
      { "id": "e38",                         "source": "committee-vote-join",    "target": "committee-tally" },
      { "id": "e39",                         "source": "committee-tally",        "target": "create-facility",      "condition": "(variables.committee_vote_cro == 'approve' && variables.committee_vote_director == 'approve') || (variables.committee_vote_cro == 'approve' && variables.committee_vote_ceo == 'approve') || (variables.committee_vote_director == 'approve' && variables.committee_vote_ceo == 'approve')" },
      { "id": "e40",                         "source": "committee-tally",        "target": "decline-application",  "condition": "(variables.committee_vote_cro == 'reject' && variables.committee_vote_director == 'reject') || (variables.committee_vote_cro == 'reject' && variables.committee_vote_ceo == 'reject') || (variables.committee_vote_director == 'reject' && variables.committee_vote_ceo == 'reject')" },
      { "id": "e40-default",                 "source": "committee-tally",        "target": "decline-application",  "is_default": true },
      { "id": "e26",                         "source": "create-facility",        "target": "disburse-loan" },
      { "id": "e27",                         "source": "disburse-loan",          "target": "end-disbursed" },
      { "id": "e28",                         "source": "decline-application",    "target": "end-declined" }
    ]
  },
  "variable_schemas": [
    {"variable_key": "kyc_status", "json_schema": {"type": "string", "enum": ["clear", "hit", "inconclusive"]}},
    {"variable_key": "kyc_outcome", "json_schema": {"type": "string", "enum": ["cleared", "rejected", "unresolved"]}},
    {"variable_key": "credit_decision", "json_schema": {"type": "string", "enum": ["pass", "fail"]}},
    {"variable_key": "risk_rating", "json_schema": {"type": "string", "enum": ["low", "medium", "high", "acceptable", "unacceptable"]}},
    {"variable_key": "requested_amount_eur", "json_schema": {"type": "number"}},
    {"variable_key": "l1_decision", "json_schema": {"type": "string", "enum": ["approve", "escalate", "reject"]}},
    {"variable_key": "l2_decision", "json_schema": {"type": "string", "enum": ["approve", "reject"]}},
    {"variable_key": "committee_vote_cro", "json_schema": {"type": "string", "enum": ["approve", "reject"]}},
    {"variable_key": "committee_vote_director", "json_schema": {"type": "string", "enum": ["approve", "reject"]}},
    {"variable_key": "committee_vote_ceo", "json_schema": {"type": "string", "enum": ["approve", "reject"]}}
  ]
}
