{
  "name": "Loan Origination",
  "version": "1.7",
  "description": "Full SME loan origination flow. Three parallel assessment tracks (credit, risk, KYC/AML). Standard path uses L1+L2 sign-off; large loans go to Credit Committee (multi-voter, mapped to HUMAN_TASK). Exercises: parallel fork-join, conditional authority routing, service-task core banking. KYC/AML fails closed (v1.7): the eligibility gate lets an application on to approval only when the screening answered kyc_status 'clear' or the compliance officer's manual review recorded kyc_outcome 'cleared' (the kyc-manual-review task is completed with output variable kyc_outcome = cleared | rejected); a rejected, missing or timed-out review (kyc-timeout records kyc_outcome 'unresolved') declines the application.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "node_type": "START"
      },
      {
        "id": "parallel-assessment-fork",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "credit-memo-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-manager"
        }
      },
      {
        "id": "credit-memo-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "risk-assessment",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-risk-manager"
        }
      },
      {
        "id": "risk-assessment-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "kyc-aml-check",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/response-headers?kyc_status=clear",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "kyc-manual-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-compliance-officer"
        }
      },
      {
        "id": "kyc-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/response-headers?kyc_outcome=unresolved",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "kyc-routing",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "assessment-join",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "eligibility-gate",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "authority-routing",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "l1-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-manager"
        }
      },
      {
        "id": "l2-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-credit-director"
        }
      },
      {
        "id": "committee-vote-fork",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "committee-vote-cro",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-committee-member"
        }
      },
      {
        "id": "committee-vote-director",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-committee-member"
        }
      },
      {
        "id": "committee-vote-ceo",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-committee-member"
        }
      },
      {
        "id": "committee-vote-cro-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-director-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-ceo-timeout",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/applications/{{variables.application_id}}/flag",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "committee-vote-join",
        "node_type": "PARALLEL_GATEWAY"
      },
      {
        "id": "committee-tally",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "create-facility",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/core-banking/facilities",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "disburse-loan",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-loan-ops"
        }
      },
      {
        "id": "decline-application",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/crm/applications/{{variables.application_id}}/decline",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "end-disbursed",
        "node_type": "END"
      },
      {
        "id": "end-declined",
        "node_type": "END"
      }
    ],
    "edges": [
      { "id": "e0",                          "source": "start",                  "target": "parallel-assessment-fork" },
      { "id": "e1",                          "source": "parallel-assessment-fork", "target": "credit-memo-review" },
      { "id": "e2",                          "source": "parallel-assessment-fork", "target": "risk-assessment" },
      { "id": "e3",                          "source": "parallel-assessment-fork", "target": "kyc-aml-check" },
      { "id": "e4",                          "source": "credit-memo-review",     "target": "assessment-join" },
      { "id": "timeout-credit-memo-review",  "source": "credit-memo-review",     "target": "credit-memo-timeout" },
      { "id": "e5",                          "source": "credit-memo-timeout",    "target": "assessment-join" },
      { "id": "e6",                          "source": "risk-assessment",        "target": "assessment-join" },
      { "id": "timeout-risk-assessment",     "source": "risk-assessment",        "target": "risk-assessment-timeout" },
      { "id": "e7",                          "source": "risk-assessment-timeout", "target": "assessment-join" },
      { "id": "e8",                          "source": "kyc-aml-check",          "target": "kyc-routing" },
      { "id": "e9",                          "source": "kyc-routing",            "target": "assessment-join",      "condition": "variables.kyc_status == 'clear'" },
      { "id": "e10",                         "source": "kyc-routing",            "target": "kyc-manual-review",    "condition": "variables.kyc_status == 'hit'" },
      { "id": "e11",                         "source": "kyc-routing",            "target": "kyc-manual-review",    "condition": "variables.kyc_status == 'inconclusive'" },
      { "id": "e9-default",                  "source": "kyc-routing",            "target": "kyc-manual-review",      "is_default": true },
      { "id": "e12",                         "source": "kyc-manual-review",      "target": "assessment-join" },
      { "id": "timeout-kyc-manual-review",   "source": "kyc-manual-review",      "target": "kyc-timeout" },
      { "id": "e13",                         "source": "kyc-timeout",            "target": "assessment-join" },
      { "id": "e14",                         "source": "assessment-join",        "target": "eligibility-gate" },
      { "id": "e15",                         "source": "eligibility-gate",       "target": "authority-routing",    "condition": "variables.credit_decision == 'pass' && variables.risk_rating != null && variables.risk_rating != '' && variables.risk_rating != 'unacceptable' && variables.kyc_status == 'clear'" },
      { "id": "e15-kyc-cleared",            "source": "eligibility-gate",       "target": "authority-routing",    "condition": "variables.credit_decision == 'pass' && variables.risk_rating != null && variables.risk_rating != '' && variables.risk_rating != 'unacceptable' && variables.kyc_outcome == 'cleared'" },
      { "id": "e16",                         "source": "eligibility-gate",       "target": "decline-application",  "condition": "variables.credit_decision == 'fail' || variables.risk_rating == 'unacceptable'" },
      { "id": "eligibility-gate-default", "source": "eligibility-gate", "target": "decline-application", "is_default": true },
      { "id": "e17",                         "source": "authority-routing",      "target": "l1-approval",          "condition": "variables.requested_amount_eur <= 500000" },
      { "id": "e18",                         "source": "authority-routing",      "target": "committee-vote-fork",  "condition": "variables.requested_amount_eur > 500000" },
      { "id": "authority-routing-default", "source": "authority-routing", "target": "decline-application", "is_default": true },
      { "id": "e19",                         "source": "l1-approval",            "target": "l2-approval",          "condition": "variables.l1_decision == 'approve' || variables.l1_decision == 'escalate'" },
      { "id": "e20",                         "source": "l1-approval",            "target": "decline-application",  "condition": "variables.l1_decision == 'reject'" },
      { "id": "fallback-l1-approval",        "source": "l1-approval",            "target": "l2-approval" },
      { "id": "e21",                         "source": "l2-approval",            "target": "create-facility",      "condition": "variables.l2_decision == 'approve'" },
      { "id": "e22",                         "source": "l2-approval",            "target": "decline-application",  "condition": "variables.l2_decision == 'reject'" },
      { "id": "fallback-l2-approval",        "source": "l2-approval",            "target": "decline-application" },
      { "id": "e29",                         "source": "committee-vote-fork",    "target": "committee-vote-cro" },
      { "id": "e30",                         "source": "committee-vote-fork",    "target": "committee-vote-director" },
      { "id": "e31",                         "source": "committee-vote-fork",    "target": "committee-vote-ceo" },
      { "id": "e32",                         "source": "committee-vote-cro",     "target": "committee-vote-join" },
      { "id": "e33",                         "source": "committee-vote-director", "target": "committee-vote-join" },
      { "id": "e34",                         "source": "committee-vote-ceo",     "target": "committee-vote-join" },
      { "id": "timeout-committee-vote-cro",      "source": "committee-vote-cro",      "target": "committee-vote-cro-timeout" },
      { "id": "timeout-committee-vote-director", "source": "committee-vote-director", "target": "committee-vote-director-timeout" },
      { "id": "timeout-committee-vote-ceo",      "source": "committee-vote-ceo",      "target": "committee-vote-ceo-timeout" },
      { "id": "e35",                         "source": "committee-vote-cro-timeout",      "target": "committee-vote-join" },
      { "id": "e36",                         "source": "committee-vote-director-timeout", "target": "committee-vote-join" },
      { "id": "e37",                         "source": "committee-vote-ceo-timeout",      "target": "committee-vote-join" },
      { "id": "e38",                         "source": "committee-vote-join",    "target": "committee-tally" },
      { "id": "e39",                         "source": "committee-tally",        "target": "create-facility",      "condition": "(variables.committee_vote_cro == 'approve' && variables.committee_vote_director == 'approve') || (variables.committee_vote_cro == 'approve' && variables.committee_vote_ceo == 'approve') || (variables.committee_vote_director == 'approve' && variables.committee_vote_ceo == 'approve')" },
      { "id": "e40",                         "source": "committee-tally",        "target": "decline-application",  "condition": "(variables.committee_vote_cro == 'reject' && variables.committee_vote_director == 'reject') || (variables.committee_vote_cro == 'reject' && variables.committee_vote_ceo == 'reject') || (variables.committee_vote_director == 'reject' && variables.committee_vote_ceo == 'reject')" },
      { "id": "e40-default",                 "source": "committee-tally",        "target": "decline-application",  "is_default": true },
      { "id": "e26",                         "source": "create-facility",        "target": "disburse-loan" },
      { "id": "e27",                         "source": "disburse-loan",          "target": "end-disbursed" },
      { "id": "e28",                         "source": "decline-application",    "target": "end-declined" }
    ]
  }
}
