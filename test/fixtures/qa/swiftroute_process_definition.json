{
  "name": "Shipment Approval",
  "version": "1.4",
  "description": "Sequential approval chain for high-value or non-standard shipments. Dispatcher raises the request; Operations Manager reviews; if value exceeds 500 the CEO must co-sign. Exercises: sequential chain + CEL conditional branch. Escalation follows D-ESC: timer -> higher role -> fail closed (v1.4, ISS-1007 / Q-989; BA ruling GH #2281). Every human task carries the escalation_timer_duration + escalation_role pair; when the timer fires the engine cancels the task and follows the node's single unconditioned (timeout) edge. Chain: ops-review (role-ops-manager, PT2H, the existing E7 exception) -> ceo-approval (role-ceo, PT4H) -> stalled: auto-reject, never release-shipment. Deviations (documented, no waivers): ceo-approval takes PT4H rather than the financial P2D because a shipment awaiting co-signature is time-sensitive operational work, consistent with ops-review's PT2H. ceo-approval is the top of the chain (E4): its escalation_role repeats its own role as a nominal CHK-21 co-required attribute and its timeout edge goes straight to the fail-closed auto-reject.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "node_type": "START"
      },
      {
        "id": "ops-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-ops-manager",
          "escalation_timer_duration": "PT2H",
          "escalation_role": "role-ceo"
        }
      },
      {
        "id": "ceo-approval-gate",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "ceo-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-ceo",
          "description": "top of chain: escalation_role is nominal; stalled = fail closed",
          "escalation_timer_duration": "PT4H",
          "escalation_role": "role-ceo"
        }
      },
      {
        "id": "release-shipment",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/shipments/{{variables.shipment_id}}/release",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "auto-reject",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/internal/shipments/{{variables.shipment_id}}/reject",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "notify-requester",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/webhooks/notify",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "end-approved",
        "node_type": "END"
      },
      {
        "id": "end-rejected",
        "node_type": "END"
      }
    ],
    "edges": [
      { "id": "e0",                   "source": "start",             "target": "ops-review" },
      { "id": "e1",                   "source": "ops-review",        "target": "ceo-approval-gate", "condition": "variables.ops_decision == 'approve'" },
      { "id": "e2",                   "source": "ops-review",        "target": "notify-requester",  "condition": "variables.ops_decision == 'reject'" },
      { "id": "fallback-ops-review",  "source": "ops-review",        "target": "ceo-approval" },
      { "id": "e3",                   "source": "ceo-approval-gate", "target": "ceo-approval",      "condition": "variables.declared_value > 500" },
      { "id": "e4",                   "source": "ceo-approval-gate", "target": "release-shipment",  "condition": "variables.declared_value <= 500" },
      { "id": "ceo-approval-gate-default", "source": "ceo-approval-gate", "target": "ceo-approval", "is_default": true },
      { "id": "e5",                   "source": "ceo-approval",      "target": "release-shipment",  "condition": "variables.ceo_decision == 'approve'" },
      { "id": "e6",                   "source": "ceo-approval",      "target": "auto-reject",       "condition": "variables.ceo_decision == 'reject'" },
      { "id": "timeout-ceo-approval", "source": "ceo-approval",      "target": "auto-reject" },
      { "id": "e7",                   "source": "release-shipment",  "target": "end-approved" },
      { "id": "e8",                   "source": "auto-reject",       "target": "end-rejected" },
      { "id": "e9",                   "source": "notify-requester",  "target": "end-rejected" }
    ]
  },
  "variable_schemas": [
    {"variable_key": "ops_decision", "json_schema": {"type": "string", "enum": ["approve", "reject"]}},
    {"variable_key": "declared_value", "json_schema": {"type": "number"}},
    {"variable_key": "ceo_decision", "json_schema": {"type": "string", "enum": ["approve", "reject"]}}
  ]
}
