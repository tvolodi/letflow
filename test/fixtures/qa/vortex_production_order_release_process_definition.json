{
  "name": "Production Order Release",
  "version": "1.4",
  "description": "Multi-level release gate for a new production order. Planner creates the order; Production Manager reviews; if value > 10000 Financial Controller signs off. Timer escalation to CEO. Exercises: sequential chain, timer escalation, conditional branch.",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "node_type": "START"
      },
      {
        "id": "capacity-review",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-production-manager"
        }
      },
      {
        "id": "escalate-to-ceo",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-ceo"
        }
      },
      {
        "id": "budget-gate",
        "node_type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "budget-approval",
        "node_type": "HUMAN_TASK",
        "attributes": {
          "role": "role-controller"
        }
      },
      {
        "id": "assign-line",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/mes/orders/{{variables.order_id}}/assign",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "auto-reject-order",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/mes/orders/{{variables.order_id}}/reject",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "notify-planner",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/webhooks/notify",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "notify-planner-rejected",
        "node_type": "SERVICE_TASK",
        "attributes": {
          "endpoint": "https://httpbin.org/anything/webhooks/notify",
          "method": "POST",
          "timeout_ms": 300000
        }
      },
      {
        "id": "end-released",
        "node_type": "END"
      },
      {
        "id": "end-rejected",
        "node_type": "END"
      }
    ],
    "edges": [
      { "id": "e0",                       "source": "start",             "target": "capacity-review" },
      { "id": "e1",                       "source": "capacity-review",   "target": "budget-gate",       "condition": "variables.capacity_decision == 'approve'" },
      { "id": "e2",                       "source": "capacity-review",   "target": "notify-planner-rejected", "condition": "variables.capacity_decision == 'reject'" },
      { "id": "timeout-capacity-review",  "source": "capacity-review",   "target": "escalate-to-ceo" },
      { "id": "e3",                       "source": "escalate-to-ceo",   "target": "budget-gate",       "condition": "variables.capacity_decision == 'approve'" },
      { "id": "e4",                       "source": "escalate-to-ceo",   "target": "auto-reject-order", "condition": "variables.capacity_decision == 'reject'" },
      { "id": "timeout-escalate-to-ceo",  "source": "escalate-to-ceo",   "target": "auto-reject-order" },
      { "id": "e5",                       "source": "budget-gate",       "target": "budget-approval",   "condition": "variables.order_value_eur > 10000" },
      { "id": "e6",                       "source": "budget-gate",       "target": "assign-line",       "condition": "variables.order_value_eur <= 10000" },
      { "id": "budget-gate-default", "source": "budget-gate", "target": "budget-approval", "is_default": true },
      { "id": "e7",                       "source": "budget-approval",   "target": "assign-line",       "condition": "variables.budget_decision == 'approve'" },
      { "id": "e8",                       "source": "budget-approval",   "target": "auto-reject-order", "condition": "variables.budget_decision == 'reject'" },
      { "id": "timeout-budget-approval",  "source": "budget-approval",   "target": "auto-reject-order" },
      { "id": "e9",                       "source": "assign-line",       "target": "notify-planner" },
      { "id": "e10",                      "source": "notify-planner",    "target": "end-released" },
      { "id": "e11",                      "source": "auto-reject-order", "target": "end-rejected" },
      { "id": "e12",                      "source": "notify-planner-rejected", "target": "end-rejected" }
    ]
  },
  "variable_schemas": [
    {"variable_key": "capacity_decision", "json_schema": {"type": "string", "enum": ["approve", "reject"]}},
    {"variable_key": "order_value_eur", "json_schema": {"type": "number"}},
    {"variable_key": "budget_decision", "json_schema": {"type": "string", "enum": ["approve", "reject"]}}
  ]
}
